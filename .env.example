# ==========================================
# Enterprise RAG Assistant - Environment Configuration
# Copy this file to .env before starting the services
# ==========================================

# Core Application Settings
PROJECT_NAME="Enterprise RAG Assistant"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Security & JWT Tokens
# Generated secure 32+ byte string for production
SECRET_KEY="supersecret_enterprise_rag_jwt_key_change_in_production_32bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL with pgvector)
# For local development outside Docker:
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5433/enterprise_rag"
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5433/enterprise_rag"

# For running within Docker Compose networks:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@postgres:5432/enterprise_rag"
# SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres@postgres:5432/enterprise_rag"

# Redis Cache & Sliding Window Rate Limiting
# Outside Docker:
REDIS_URL="redis://localhost:6380/0"
# Inside Docker Compose:
# REDIS_URL="redis://redis:6379/0"

# AI Provider Credentials (Optional: offline deterministic fallback is active if unset)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Document Chunking Limits
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
